#!/usr/bin/env bash
# Block staged files over the size limit. Bypass once: git commit --no-verify
limit=${MAX_FILE_BYTES:-1048576}
status=0

git diff --cached --name-only --diff-filter=AM -z | {
  while IFS= read -r -d '' path; do
    size=$(git cat-file -s ":$path")
    if [ "$size" -gt "$limit" ]; then
      printf '%s: %s KB (limit %s KB)\n' "$path" $((size / 1024)) $((limit / 1024)) >&2
      status=1
    fi
  done
  if [ "$status" -ne 0 ]; then
    echo "Commit blocked: file over size limit. Shrink it, or commit with --no-verify." >&2
  fi
  exit $status
}
